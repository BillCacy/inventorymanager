DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth — generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-secret"

# Seed data — used only by prisma/seed.ts to create the demo admin user
ADMIN_EMAIL="admin@nimbustech.demo"
ADMIN_PASSWORD="NimbusAdmin123!"

# Sanity CMS — catalog content (products, categories, images) is managed in Sanity Studio
NEXT_PUBLIC_SANITY_PROJECT_ID="o5hhr4br"
NEXT_PUBLIC_SANITY_DATASET="production"
# Where the admin "Edit in Studio" links point (use http://localhost:3333 for a local `sanity dev`)
NEXT_PUBLIC_SANITY_STUDIO_URL="https://bc-nimbustech.sanity.studio"
