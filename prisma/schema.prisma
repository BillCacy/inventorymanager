// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

enum UserRole {
  ADMIN
}

// Inventory record for a product. Catalog content (name, description, price,
// images, category) lives in Sanity and is joined to this row on `sku`.
model Product {
  id         String      @id @default(cuid())
  sku        String      @unique
  stock      Int         @default(0)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  customerName  String
  customerEmail String
  status        OrderStatus @default(PENDING)
  totalCents    Int
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  // Snapshot of the product name at purchase time (catalog content lives in Sanity)
  productName   String
  product       Product @relation(fields: [productId], references: [id])
  quantity      Int
  unitPriceCents Int
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
}
